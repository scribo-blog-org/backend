PORT=3001
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_REFRESH_KEY=
PASSWORD_SALT=10
MONGODB_URI=mongodb://scribo:scribo@127.0.0.1:27017/scribo?authSource=admin
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_NAME=
FRONTEND_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001

MAIL_SENDER=
MAIL_PASSWORD=

# Каталог загруженных картинок. По умолчанию ./uploads рядом с процессом.
UPLOADS_DIR=
# Публичный адрес каталога для логов и старых абсолютных ссылок.
# В базе хранится путь /uploads/..., домен подставляет клиент.
# По умолчанию <API_ORIGIN>/uploads.
UPLOADS_PUBLIC_URL=
# В dev backend сам отдаёт /uploads; в проде (NODE_ENV=production) нет, там nginx.
# SERVE_UPLOADS=true

# Бекапы базы и загрузок из админки (вкладка «Бекапы», только tech_admin).
# true включает ежедневный запуск и ручной запуск, false выключает оба.
BACKUP_ENABLED=false
# Каталог с архивами. По умолчанию ./backups рядом с процессом.
BACKUPS_DIR=
# Время ежедневного запуска по UTC.
# Откат на бекап из админки (кнопка «Восстановить»). Отдельный предохранитель:
# по умолчанию выключен, включать там, где откат нужен. Требует BACKUP_ENABLED=true.
BACKUP_RESTORE_ENABLED=false
# BACKUP_AT=04:15
# Хранение: за сегодня все бекапы, за последние N суток по одному в день
# (последний за день), дальше по одному на месяц (последний день месяца)
# за M месяцев.
# BACKUP_KEEP_DAILY_DAYS=7
# BACKUP_KEEP_MONTHS=12
# Сколько страховочных снимков перед откатом хранить. После успешного отката снимок удаляется.
# BACKUP_KEEP_PRE_RESTORE=1
# Загрузка своего архива в админке: сколько таких архивов хранить и самый большой файл в МБ.
# BACKUP_KEEP_UPLOADED=3
# BACKUP_UPLOAD_MAX_MB=2048
# Пути к mongodump, mongorestore и tar, если их нет в PATH.
# MONGODUMP_BIN=mongodump
# MONGORESTORE_BIN=mongorestore
# TAR_BIN=tar

REDIS_URL=redis://127.0.0.1:6379
